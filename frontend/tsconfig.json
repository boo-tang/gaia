{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "noEmit": true
  },
  "include": [
    "src"
  ],
  // The root config excludes "frontend". Without this override, the exclude is inherited and
  // no file is checked.
  "exclude": []
}