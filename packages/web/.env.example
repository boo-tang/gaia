# Copy this file to .env.local and change the values. All variables are optional for the local
# node (`yarn chain:local`, `yarn deploy:local`, `yarn workspace @gaia/server start`).

# The deployment file. A relative path starts at the repository root. The chain of the app is the
# chain of this file (31337: Anvil, 84532: Base Sepolia).
DEPLOYMENT_FILE=deployments/local.json

# Development only: the Vite server sends /api/* to this server.
API_PROXY_TARGET=http://localhost:8787

# The API base URL in the browser. Production sets the full URL of the server.
VITE_API_URL=/api

# The RPC URL of the deployment chain. Default for Anvil: http://127.0.0.1:8545. Required for
# Base Sepolia.
VITE_RPC_URL=

# The WalletConnect project ID (https://cloud.reown.com). Empty: no WalletConnect wallets.
VITE_WALLETCONNECT_PROJECT_ID=

# The map style: a style URL of the OpenMapTiles schema. The map takes its tiles and place names
# and uses our own colours. Default: OpenFreeMap "Positron" (no key).
VITE_MAP_STYLE_URL=
